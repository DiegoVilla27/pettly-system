{
  "name": "@pettly/notifications-runtime",
  "private": true,
  "version": "0.0.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "name": "notifications-runtime",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "api:prisma-generate"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "command": "tsc -p packages/notifications-runtime/tsconfig.json"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec eslint packages/notifications-runtime/src"
        }
      }
    }
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bullmq": "^6.3.11",
    "dotenv": "^18.0.6",
    "nodemailer": "^10.0.16"
  }
}
