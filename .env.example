# Puertos propios de Pettly para convivir con task-manager y el desarrollo local.
API_PORT=3100
WEB_PORT=3101
ADMIN_PORT=4300

# PostgreSQL existente en shared-network. Configura los valores de tu instancia.
DB_HOST=global_postgres
DB_PORT=5432
DB_NAME=pettly_db
DB_USER=pettly_dev
DB_PASSWORD=

# Prisma URLs: percent-encode special characters in credentials.
DATABASE_URL=postgresql://pettly_dev:CHANGE_ME@localhost:5432/pettly_db?schema=public
DATABASE_URL_DOCKER=postgresql://pettly_dev:CHANGE_ME@global_postgres:5432/pettly_db?schema=public
REDIS_URL=redis://localhost:6379
REDIS_URL_DOCKER=redis://global_redis:6379
REDIS_PREFIX=pettly:dev

# Generate independent secrets, each with at least 32 random characters.
JWT_SECRET=
MAIL_ENCRYPTION_KEY=
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=2592000
VERIFICATION_TOKEN_SECONDS=86400
RESET_TOKEN_SECONDS=1800

# SMTP defaults to local Mailpit. No real email delivery in development.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Pettly <support@pettly.test>
WEB_PUBLIC_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://localhost:4200,http://localhost:3101,http://localhost:4300,http://localhost:3000,http://localhost:3100
SWAGGER_ENABLED=true
# Only local Docker development may disable HTTPS/Secure cookie requirements.
ALLOW_INSECURE_LOCAL_DEV=true

# Pettly commission percentage: 0–100, at most two decimals. Restart API after changes.
# Applied to new quotes only; existing accepted orders retain their allocation.
PETTLY_COMMISSION_PERCENT=10

# Dedicated Prometheus bearer token, >=32 characters; empty disables /api/metrics.
METRICS_TOKEN=
# Backup encryption: exactly 64 hexadecimal characters, stored separately from backup files.
PETTLY_BACKUP_KEY=
