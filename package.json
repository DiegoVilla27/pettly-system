{
  "name": "@pettly/source",
  "version": "0.0.0",
  "scripts": {
    "nx": "nx",
    "graph": "nx graph",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "nx run-many -t lint test build typecheck",
    "dev:api": "nx serve api",
    "build:api": "nx build api",
    "dev:web": "nx dev web --port=3001",
    "build:web": "nx build web",
    "dev:admin": "nx serve admin",
    "build:admin": "nx build admin",
    "dev:mobile": "nx serve mobile",
    "check:mobile": "nx run mobile:lint",
    "build:mobile:android": "nx run mobile:build-android",
    "build:mobile:ios": "nx run mobile:build-ios",
    "prepare": "husky",
    "commitlint": "commitlint",
    "check:server": "nx run-many -t lint typecheck build -p api web admin",
    "docker:up": "docker compose up --build -d --wait --wait-timeout 120",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose build",
    "docker:config": "docker compose config --quiet",
    "test:ci": "node --test scripts/ci/*.test.mjs",
    "docker:ci:config": "docker compose -f docker-compose.yml -f docker-compose.ci.yml config --quiet",
    "docker:ci:up": "docker compose -f docker-compose.yml -f docker-compose.ci.yml up --build -d --wait --wait-timeout 180",
    "docker:ci:down": "docker compose -f docker-compose.yml -f docker-compose.ci.yml down --volumes --remove-orphans"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/core": "~22.1.0",
    "@angular-devkit/schematics": "~22.1.0",
    "@angular/build": "~22.1.0",
    "@angular/cli": "~22.1.0",
    "@angular/compiler-cli": "~22.1.0",
    "@angular/language-service": "~22.1.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/angular": "23.2.0",
    "@nx/eslint": "23.2.0",
    "@nx/eslint-plugin": "23.2.0",
    "@nx/js": "23.2.0",
    "@nx/nest": "23.2.0",
    "@nx/next": "23.2.0",
    "@nx/node": "23.2.0",
    "@nx/web": "23.2.0",
    "@nx/webpack": "23.2.0",
    "@schematics/angular": "~22.1.0",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nx": "23.2.0",
    "prettier": "^3.8.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25"
  },
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@angular/common": "~22.1.0",
    "@angular/compiler": "~22.1.0",
    "@angular/core": "~22.1.0",
    "@angular/forms": "~22.1.0",
    "@angular/platform-browser": "~22.1.0",
    "@angular/router": "~22.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  }
}
